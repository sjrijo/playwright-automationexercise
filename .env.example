# Copy to .env (and optionally .env.dev / .env.qa / .env.staging) and adjust.
# Select an environment file with:  TEST_ENV=staging npx playwright test
# (or use the npm scripts: npm run test:dev | test:qa | test:staging)

# Application under test
BASE_URL=https://automationexercise.com

# Comma-separated browser projects to run: chromium, firefox, webkit
BROWSERS=chromium

# Optional: reuse an existing account for the logged-in tests.
# Leave empty to create a fresh account per run (deleted automatically afterwards).
USER_EMAIL=
USER_PASSWORD=
